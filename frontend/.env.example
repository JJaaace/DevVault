# Public HTTPS origin of the deployed Express API. Do not include a trailing slash.
VITE_API_BASE_URL=https://api.example.com
# Clerk production publishable key. VITE_ variables are public; never put a secret key here.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
# Canonical public frontend origin used for portfolio links and metadata.
VITE_PUBLIC_APP_URL=https://example.com

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id             Int      @id @default(autoincrement())
  clerkUserId    String   @unique
  username       String   @unique
  firstName      String
  lastName       String
  bio            String
  profileImage   String?
  country        String?
  state          String?
  university     String?
  graduationYear Int?
  githubUrl      String?
  linkedinUrl    String?
  websiteUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

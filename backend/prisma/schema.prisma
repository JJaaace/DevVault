generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int       @id @default(autoincrement())
  clerkUserId String    @unique
  projects    Project[]
  skills      Skill[]
}

model Profile {
  id                Int      @id @default(autoincrement())
  clerkUserId       String   @unique
  username          String   @unique
  firstName         String
  lastName          String
  bio               String
  profileImageUrl   String?
  school            String?
  graduationYear    Int?
  major             String?
  location          String?
  dreamCompanies    String[] @default([])
  currentRole       String?
  favoriteLanguage  String?
  favoriteFramework String?
  yearsCoding       Int?
  interests         String[] @default([])
  githubUrl         String?
  linkedinUrl       String?
  websiteUrl        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Project {
  id                  Int            @id @default(autoincrement())
  ownerClerkUserId     String
  owner                User           @relation(fields: [ownerClerkUserId], references: [clerkUserId], onDelete: Cascade)
  title                String
  description          String
  githubUrl            String?
  liveDemoUrl          String?
  bannerImageUrl       String?
  techStack            String[]       @default([])
  status               ProjectStatus  @default(PLANNING)
  completionPercentage Int           @default(0)
  dateStarted          DateTime?
  targetCompletion     DateTime?
  challenges           String?
  lessonsLearned       String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  skillProjects        SkillProject[]

  @@index([ownerClerkUserId])
  @@index([status])
  @@index([updatedAt])
}

model Skill {
  id                  Int                  @id @default(autoincrement())
  ownerClerkUserId    String
  owner               User                 @relation(fields: [ownerClerkUserId], references: [clerkUserId], onDelete: Cascade)
  name                String
  category            String
  experienceLevel     SkillExperienceLevel
  percentage          Int                  @default(0)
  color               String
  lastUsed            DateTime?
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  relatedProjects     SkillProject[]

  @@index([ownerClerkUserId])
  @@index([category])
  @@index([updatedAt])
}

model SkillProject {
  skillId   Int
  projectId Int
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([skillId, projectId])
  @@index([projectId])
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum SkillExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

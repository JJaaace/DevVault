# Production runtime. Hosting providers commonly inject PORT automatically.
NODE_ENV=production
PORT=5000
# PostgreSQL is the only supported production persistence mode.
PERSISTENCE_MODE=postgres
# Secret hosted PostgreSQL connection string. Prefer the provider's SSL-enabled URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Clerk production keys. CLERK_SECRET_KEY is a secret and belongs only on the backend.
CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_SECRET_KEY=sk_live_REPLACE_ME
# Exact comma-separated HTTPS frontend origins. Wildcards and paths are rejected.
CORS_ORIGINS=https://example.com
# Optional backend-only token for higher GitHub API rate limits.
GITHUB_TOKEN=
# Development only; omit this variable entirely in production.
# DEV_CLERK_USER_ID=dev-local-user
